# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/fsin_crm?schema=public"

# JWT — generate your own secret, e.g.: openssl rand -hex 32
JWT_SECRET="change-me-minimum-32-characters-long"
JWT_EXPIRES_IN="15m"

# Server
PORT=3000
CLIENT_ORIGIN="http://localhost:4200"

# Node
NODE_ENV=development
